# ==============================================================================
# Qazaq Loc QA — Backend Environment Configuration Example
# Copy to `.env` for local overrides. NEVER commit `.env` to GitHub!
# ==============================================================================

# Environment mode: development | production
APP_ENV=development

# Database URL:
# - Local default (automatic if omitted): sqlite:///./data/qazaq_locqa.db
# - Render / Neon / Supabase Persistent PostgreSQL example:
#   DATABASE_URL=postgresql://user:password@hostname:5432/qazaq_locqa
DATABASE_URL=

# Maximum uploaded ARB / CSV file size in MB
QAZAQ_LOCQA_MAX_UPLOAD_MB=25

# Allowed Frontend Origins for CORS (comma-separated, no trailing slash)
# Example for Vercel: https://qazaq-loc-qa.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Optional LLM Configuration (Gemini or OpenAI-compatible)
# Leave LLM_API_KEY empty to run the deterministic Rule-Based Linguistic QA Engine.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
